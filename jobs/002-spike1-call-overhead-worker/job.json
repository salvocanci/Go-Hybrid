{
  "job": "002-spike1-call-overhead-worker",
  "tier": "any",
  "sha": "HEAD",
  "repo": "https://github.com/limitlessprojects/Go-Hybrid.git",
  "gpu": false,
  "note": "Spike 1 second tier: run the full call-overhead benchmark suite on the Kaggle worker (4 cores). Thresholds pre-registered in spikes/spike1-call-overhead/RESULTS.md.",
  "setup": [
    {
      "name": "install-go",
      "run": "curl -sL https://go.dev/dl/go1.26.9.linux-amd64.tar.gz -o /tmp/go.tgz && tar -C /tmp -xzf /tmp/go.tgz && /tmp/go/bin/go version",
      "timeout": 600
    },
    {
      "name": "install-rust",
      "run": "curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.99.0 --no-modify-path && $HOME/.cargo/bin/rustc --version",
      "timeout": 900
    }
  ],
  "commands": [
    {
      "name": "spike1-bench",
      "run": "export PATH=/tmp/go/bin:$HOME/.cargo/bin:$PATH && unset CARGO_TARGET_DIR && cd spikes/spike1-call-overhead/work && bash run.sh 2>&1",
      "timeout": 1500,
      "cwd": "repo"
    },
    {
      "name": "collect-results",
      "run": "cp spikes/spike1-call-overhead/work/bench.sandbox.out spikes/spike1-call-overhead/work/probe.out spikes/spike1-call-overhead/work/rustbench.out \"$RESULTS_DIR/\" 2>/dev/null; ls -la \"$RESULTS_DIR/\"",
      "timeout": 60,
      "cwd": "repo"
    }
  ],
  "expected_results": ["results/bench.sandbox.out", "results/probe.out", "results/rustbench.out", "results/summary.json"]
}
