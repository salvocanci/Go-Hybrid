{
  "job": "003-spike3-memory",
  "tier": "any",
  "sha": "HEAD",
  "repo": "https://github.com/limitlessprojects/Go-Hybrid.git",
  "gpu": false,
  "note": "Spike 3 second tier: arena/handle probes + crossing benchmarks on the Kaggle worker (4 cores). Thresholds pre-registered in spikes/spike3-memory/RESULTS.md.",
  "setup": [
    {
      "name": "install-go",
      "run": "curl -sL https://go.dev/dl/go1.26.9.linux-amd64.tar.gz -o /tmp/go.tgz && tar -C /tmp -xzf /tmp/go.tgz && /tmp/go/bin/go version",
      "timeout": 600
    },
    {
      "name": "install-rust",
      "run": "curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.99.0 --no-modify-path && $HOME/.cargo/bin/rustc --version",
      "timeout": 900
    }
  ],
  "commands": [
    {
      "name": "spike3-run",
      "run": "export PATH=/tmp/go/bin:$HOME/.cargo/bin:$PATH && unset CARGO_TARGET_DIR && cd spikes/spike3-memory/work && bash run.sh 2>&1",
      "timeout": 1800,
      "cwd": "repo"
    },
    {
      "name": "collect-results",
      "run": "cp spikes/spike3-memory/work/bench.sandbox.out spikes/spike3-memory/work/probe.out spikes/spike3-memory/work/hazard.out spikes/spike3-memory/work/escape.out \"$RESULTS_DIR/\" 2>/dev/null; ls -la \"$RESULTS_DIR/\"",
      "timeout": 60,
      "cwd": "repo"
    }
  ],
  "expected_results": [
    "results/bench.sandbox.out",
    "results/probe.out",
    "results/hazard.out",
    "results/summary.json"
  ]
}
