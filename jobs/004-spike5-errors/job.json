{
  "job": "004-spike5-errors",
  "tier": "any",
  "sha": "HEAD",
  "repo": "https://github.com/limitlessprojects/Go-Hybrid.git",
  "gpu": false,
  "note": "Spike 5 second tier: (T,error)<->Result mapping probes + panic contract on the Kaggle worker. Thresholds pre-registered in spikes/spike5-errors/RESULTS.md. No output pipes (SIGPIPE lesson from job 003).",
  "setup": [
    {
      "name": "install-go",
      "run": "curl -sL https://go.dev/dl/go1.26.9.linux-amd64.tar.gz -o /tmp/go.tgz && tar -C /tmp -xzf /tmp/go.tgz && /tmp/go/bin/go version",
      "timeout": 600
    },
    {
      "name": "install-rust",
      "run": "curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.99.0 --no-modify-path && $HOME/.cargo/bin/rustc --version",
      "timeout": 900
    }
  ],
  "commands": [
    {
      "name": "spike5-run",
      "run": "export PATH=/tmp/go/bin:$HOME/.cargo/bin:$PATH && unset CARGO_TARGET_DIR && cd spikes/spike5-errors/work && bash run.sh 2>&1",
      "timeout": 1800,
      "cwd": "repo"
    },
    {
      "name": "collect-results",
      "run": "cp spikes/spike5-errors/work/bench.sandbox.out spikes/spike5-errors/work/probe.out \"$RESULTS_DIR/\" 2>/dev/null; ls -la \"$RESULTS_DIR/\"",
      "timeout": 60,
      "cwd": "repo"
    }
  ],
  "expected_results": [
    "results/bench.sandbox.out",
    "results/probe.out",
    "results/summary.json"
  ]
}
